# All variables are optional. Set only what you need for the features you use.

# Email summaries (Gmail -> OpenAI -> Telegram chat) and calendar report
GOOGLE_CLIENT_ID=          # Google Cloud Console -> Credentials -> OAuth client
GOOGLE_CLIENT_SECRET=      # Same place as client ID
# Refresh tokens (one per Google account; use Setup Gmail with ?account=N)
GOOGLE_REFRESH_TOKEN=      # Account 1
GOOGLE_REFRESH_TOKEN_2=    # Account 2
GOOGLE_REFRESH_TOKEN_3=    # Account 3
GOOGLE_REFRESH_TOKEN_4=   # Account 4
GOOGLE_REFRESH_TOKEN_5=   # Account 5
OPENAI_API_KEY=            # platform.openai.com -> API keys
OPENAI_MODEL=              # Optional override; default is gpt-5-nano
TELEGRAM_BOT_TOKEN=        # Message @BotFather on Telegram to create a bot
TELEGRAM_CHAT_ID=          # Message @userinfobot on Telegram for your chat ID
MAX_EMAILS_PER_RUN=5
LABEL_FILTER=              # e.g. IMPORTANT (only process this label)
EXCLUDE_CATEGORIES=        # e.g. promotions (skip promotions); promotions,social
EMAIL_SUMMARY_ALLOWED_SENDERS= # Optional comma-separated allow-list; empty = summarize all senders
EMAIL_SUMMARY_IGNORED_SENDERS= # Optional comma-separated sender block-list; always skipped

# Daily Vransko weather report (uses TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID)
# Sends at 07:30 and 20:30 Europe/Ljubljana from the existing cron route. No weather API key needed.

# Daily calendar report (uses Google OAuth, TELEGRAM_BOT_TOKEN, and TELEGRAM_CHAT_ID)
# Sends tomorrow's events, holidays, and birthdays at 20:00 Europe/Ljubljana.
# Telegram assistant can also create events from messages like:
# add event Dentist on 2026-05-21 at 14:30
GOOGLE_CALENDAR_IDS=       # Optional comma-separated extra calendars beyond primary
GOOGLE_HOLIDAY_CALENDAR_ID= # Optional; defaults to Slovenian holidays
GOOGLE_BIRTHDAY_CALENDAR_ID= # Optional; defaults to Google birthdays

# Telegram * notes to Notion (requires TELEGRAM_BOT_TOKEN and both vars below)
NOTION_API_KEY=            # Notion integration secret
NOTION_NOTES_PAGE_ID=      # Notion page ID or page URL

# Utility pages and webhook setup
TEST_PASSWORD=             # Password for /telegram-webhook, /telegram-test, /check-mail
APP_URL=                   # e.g. http://localhost:3000 or https://yourdomain.com
TELEGRAM_WEBHOOK_SECRET=   # Optional: header secret for /api/telegram/webhook

# Scheduling / cron auth
CRON_SECRET=               # Optional bearer token for external cron callers
